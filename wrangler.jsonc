{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wetter",
  "compatibility_date": "2026-11-01",
  "main": "./src/worker.ts",
  // Redirect only (the app moved to wetter.maltee.dev). The path route is more specific than the
  // maps.maltee.dev custom domain of orbis-map, so it wins for /wetter*.
  "routes": [{ "pattern": "maps.maltee.dev/wetter*", "zone_name": "maltee.dev" }],
  "workers_dev": false,
  "preview_urls": false
}
