{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wetter",
  "compatibility_date": "2026-11-01",
  "main": "./src/worker.ts",
  // Static site: Vite builds to dist/, Cloudflare serves it under /wetter/ on the same origin as the map.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Path route (a custom domain can only cover a whole hostname). More specific than the
  // maps.maltee.dev custom domain of orbis-map, so it wins for /wetter/*.
  "routes": [{ "pattern": "maps.maltee.dev/wetter*", "zone_name": "maltee.dev" }],
  "workers_dev": false,
  "preview_urls": false
}
